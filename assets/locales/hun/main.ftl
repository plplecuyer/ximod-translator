cli-help-hint = ximod-cli <parancs> --help: egy parancs súgója. Visszatérési kódok: 0 kész, 1 kész fenntartásokkal, 2 nem készült el.
cli-help-info = játék, észlelt nyelvek, sorok típusonként, mod-szótár, felületfájlok
cli-help-import = megnyit egy szöveges, JSON vagy XML fájlt egy formátummal, és kiírja a pivotot vagy a szótárat
cli-help-apply = megnyit egy fájlt, alkalmazza a szótárkészletet, kiírja a mod-szótárt (--write-dict)
cli-help-assist = alkalmazza az asszisztenseket (szójegyzék, minták, származtatás) az egész dokumentumra, a sorok Függőben
cli-help-translate = online lefordítja a dokumentum sorait, a --max-chars korláton belül
cli-help-check = a minőségellenőrzések, jelentés soronként; 1-es kód hibák esetén
cli-help-export = kimenetet ír (strings, hybrid, override, full, dsd) a mod-szótárból
cli-help-manifest = leírja egy mappa kimeneteit: méretek, CRC-32, sorok
cli-help-compare = két szótárt vagy fordítást hasonlít össze, CSV-jelentés, egyesítés
cli-help-scan = elemez egy mappát: mit fordítana le a készlet az egyes fájlokból
cli-help-convert = szótárkonverziók (EET, SST, XML, pivot, ximdb)
cli-help-package = becsomagolja egy mappa kimeneteit a modkezelők számára (zip)
cli-help-batch = egy kötegfájl parancsait futtatja egymás után
cli-syntax-info = Használat: ximod-cli info <fájl>
cli-syntax-import = Használat: ximod-cli import <fájl> --format <id> [-o <ximdb|json>]
cli-syntax-apply = Használat: ximod-cli apply <fájl> [--dict <ximdb>…] [--base <mappa>…] [--no-personal] [--mode strict|relax|textonly|normalized|formid|fuzzy] [--overwrite none|keep-validated|keep-pending|pending-only|all] [--write-dict]
cli-syntax-assist = Használat: ximod-cli assist <fájl> [--glossary] [--patterns] [--derive] [--overwrite …] [--write-dict]
cli-syntax-translate = Használat: ximod-cli translate <fájl> --service <id> [--scope untranslated|document] --max-chars <n> [--write-dict]
cli-syntax-check = Használat: ximod-cli check <fájl> [--fail-on error|warning] [--report <csv>]
cli-syntax-export = Használat: ximod-cli export <fájl> --output strings|hybrid|override|full|dsd [--statuses validated,pending,…] [--dict <ximdb>] [--strict] [--no-esl] -o <mappa>
cli-syntax-manifest = Használat: ximod-cli manifest <mappa> [--input <plugin>…] [-o <manifest.json>]
cli-syntax-compare = Használat: ximod-cli compare <A> <B> [--mode record|text] [--fold] [--report <csv>] [--merge <ximdb> --prefer a|b]
cli-syntax-scan = Használat: ximod-cli scan <mappa> [--no-subdirs] [--scripts] [--report <csv>]
cli-syntax-convert = Használat: ximod-cli convert <bemenet> -o <kimenet>
cli-syntax-package = Használat: ximod-cli package <kimeneti mappa> [--name <mod>] [--version <verzió>] [--author <szerző>] [--website <cím>] [--description <szöveg>] [--plugin <esp>] [--no-info] [-o <zip>]
