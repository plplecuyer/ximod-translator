# --- Riga di comando ximod-cli (D-06)
cli-usage = Uso: ximod-cli <comando> [opzioni]
cli-commands = Comandi:
cli-options-common = Opzioni comuni: --game <id>, --from <iso3>, --to <iso3> (predefiniti: l'intestazione del file, poi Config.ini), --json, --quiet, --verbose, --log <file>, --lang <iso3>, --no-color, --config <cartella>, --help
cli-help-hint = ximod-cli <comando> --help: l'aiuto di un comando. Codici di ritorno: 0 fatto, 1 fatto con riserve, 2 non fatto.
cli-help-info = gioco, lingue rilevate, righe per tipo, dizionario della mod, file di interfaccia
cli-help-import = apre un file di testo, JSON o XML con un formato e scrive il pivot o il dizionario
cli-help-apply = apre un file, applica la pila di dizionari, scrive il dizionario della mod (--write-dict)
cli-help-assist = applica gli assistenti (glossario, modelli, derivazione) a tutto il documento, righe In sospeso
cli-help-translate = traduce online le righe del documento, entro il limite di --max-chars
cli-help-check = i controlli di qualità, rapporto per riga; codice 1 in caso di errori
cli-help-export = scrive un output (strings, hybrid, override, full, dsd) dal dizionario della mod
cli-help-manifest = descrive gli output di una cartella: dimensioni, CRC-32, righe
cli-help-compare = confronta due dizionari o traduzioni, rapporto CSV, unione
cli-help-scan = analizza una cartella: cosa la pila tradurrebbe di ogni file
cli-help-convert = conversioni di dizionari (EET, SST, XML, pivot, ximdb)
cli-help-package = crea il pacchetto degli output di una cartella per i gestori di mod (zip)
cli-help-batch = concatena i comandi di un file di lotto
cli-syntax-info = Uso: ximod-cli info <file>
cli-syntax-import = Uso: ximod-cli import <file> --format <id> [-o <ximdb|json>]
cli-syntax-apply = Uso: ximod-cli apply <file> [--dict <ximdb>…] [--base <cartella>…] [--no-personal] [--mode strict|relax|textonly|normalized|formid|fuzzy] [--overwrite none|keep-validated|keep-pending|pending-only|all] [--write-dict]
cli-syntax-assist = Uso: ximod-cli assist <file> [--glossary] [--patterns] [--derive] [--overwrite …] [--write-dict]
cli-syntax-translate = Uso: ximod-cli translate <file> --service <id> [--scope untranslated|document] --max-chars <n> [--write-dict]
cli-syntax-check = Uso: ximod-cli check <file> [--fail-on error|warning] [--report <csv>]
cli-syntax-export = Uso: ximod-cli export <file> --output strings|hybrid|override|full|dsd [--statuses validated,pending,…] [--dict <ximdb>] [--strict] [--no-esl] -o <cartella>
cli-syntax-manifest = Uso: ximod-cli manifest <cartella> [--input <plugin>…] [-o <manifest.json>]
cli-syntax-compare = Uso: ximod-cli compare <A> <B> [--mode record|text] [--fold] [--report <csv>] [--merge <ximdb> --prefer a|b]
cli-syntax-scan = Uso: ximod-cli scan <cartella> [--no-subdirs] [--scripts] [--report <csv>]
cli-syntax-convert = Uso: ximod-cli convert <ingresso> -o <uscita>
cli-syntax-package = Uso: ximod-cli package <cartella di output> [--name <mod>] [--version <versione>] [--author <autore>] [--website <indirizzo>] [--description <testo>] [--plugin <esp>] [--no-info] [-o <zip>]
