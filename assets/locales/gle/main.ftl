# --- Líne na n-orduithe ximod-cli (D-06)
cli-usage = Úsáid: ximod-cli <ordú> [roghanna]
cli-commands = Orduithe:
cli-options-common = Roghanna coiteanna: --game <id>, --from <iso3>, --to <iso3> (réamhshocruithe: ceanntásc an chomhaid, ansin Config.ini), --json, --quiet, --verbose, --lang <iso3>, --no-color, --config <fillteán>, --help
cli-help-hint = ximod-cli <ordú> --help: cabhair ordaithe. Cóid fhillte: 0 déanta, 1 déanta le forchoimeádais, 2 gan déanamh.
cli-help-info = cluiche, teangacha braite, línte de réir cineáil, foclóir an mhod, comhaid chomhéadain
cli-help-import = osclaíonn sé comhad téacs, JSON nó XML le formáid agus scríobhann sé an pivot nó an foclóir
cli-help-apply = osclaíonn sé comhad, cuireann sé an chruach foclóirí i bhfeidhm, scríobhann sé foclóir an mhod (--write-dict)
cli-help-assist = cuireann sé na cúntóirí (gluais, patrúin, díorthú) i bhfeidhm ar an doiciméad ar fad, línte Ar feitheamh
cli-help-translate = aistríonn sé línte an doiciméid ar líne, laistigh de --max-chars
cli-help-check = na seiceálacha cáilíochta, tuairisc de réir líne; cód 1 má tá earráidí
cli-help-export = scríobhann sé aschur (strings, hybrid, override, full, dsd) ó fhoclóir an mhod
cli-help-manifest = déanann sé cur síos ar aschuir fillteáin: méideanna, CRC-32, línte
cli-help-compare = cuireann sé dhá fhoclóir nó dhá aistriúchán i gcomparáid, tuairisc CSV, cumasc
cli-help-scan = déanann sé anailís ar fhillteán: an méid a d'aistreodh an chruach as gach comhad
cli-help-convert = tiontuithe foclóirí (EET, SST, XML, pivot, ximdb)
cli-help-package = pacáistíonn sé aschuir fillteáin do na bainisteoirí mod (zip)
cli-help-batch = ritheann sé orduithe comhaid bhaisce ceann i ndiaidh a chéile
cli-syntax-info = Úsáid: ximod-cli info <comhad>
cli-syntax-import = Úsáid: ximod-cli import <comhad> --format <id> [-o <ximdb|json>]
cli-syntax-apply = Úsáid: ximod-cli apply <comhad> [--dict <ximdb>…] [--base <fillteán>…] [--no-personal] [--mode strict|relax|textonly|normalized|formid|fuzzy] [--overwrite none|keep-validated|keep-pending|pending-only|all] [--write-dict]
cli-syntax-assist = Úsáid: ximod-cli assist <comhad> [--glossary] [--patterns] [--derive] [--overwrite …] [--write-dict]
cli-syntax-translate = Úsáid: ximod-cli translate <comhad> --service <id> [--scope untranslated|document] --max-chars <n> [--write-dict]
cli-syntax-check = Úsáid: ximod-cli check <comhad> [--fail-on error|warning] [--report <csv>]
cli-syntax-export = Úsáid: ximod-cli export <comhad> --output strings|hybrid|override|full|dsd [--statuses validated,pending,…] [--dict <ximdb>] [--strict] [--no-esl] -o <fillteán>
cli-syntax-manifest = Úsáid: ximod-cli manifest <fillteán> [--input <plugin>…] [-o <manifest.json>]
cli-syntax-compare = Úsáid: ximod-cli compare <A> <B> [--mode record|text] [--fold] [--report <csv>] [--merge <ximdb> --prefer a|b]
cli-syntax-scan = Úsáid: ximod-cli scan <fillteán> [--no-subdirs] [--scripts] [--report <csv>]
cli-syntax-convert = Úsáid: ximod-cli convert <ionchur> -o <aschur>
cli-syntax-package = Úsáid: ximod-cli package <fillteán aschuir> [--name <mod>] [--version <leagan>] [--author <údar>] [--website <seoladh>] [--description <téacs>] [--plugin <esp>] [--no-info] [-o <zip>]
