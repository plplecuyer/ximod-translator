# --- Příkazový řádek ximod-cli (D-06)
cli-usage = Použití: ximod-cli <příkaz> [volby]
cli-commands = Příkazy:
cli-options-common = Společné volby: --game <id>, --from <iso3>, --to <iso3> (výchozí: hlavička souboru, pak Config.ini), --json, --quiet, --verbose, --lang <iso3>, --no-color, --config <složka>, --help
cli-help-hint = ximod-cli <příkaz> --help: nápověda k příkazu. Návratové kódy: 0 hotovo, 1 hotovo s výhradami, 2 nehotovo.
cli-help-info = hra, zjištěné jazyky, řádky podle typu, slovník modu, soubory rozhraní
cli-help-import = otevře textový soubor, JSON nebo XML s formátem a zapíše pivot nebo slovník
cli-help-apply = otevře soubor, použije zásobník slovníků, zapíše slovník modu (--write-dict)
cli-help-assist = použije asistenty (glosář, vzory, odvozeniny) na celý dokument, řádky Nevyřízeno
cli-help-translate = přeloží řádky dokumentu online, v mezích --max-chars
cli-help-check = kontroly kvality, zpráva po řádcích; kód 1 při chybách
cli-help-export = zapíše výstup (strings, hybrid, override, full, dsd) ze slovníku modu
cli-help-manifest = popíše výstupy složky: velikosti, CRC-32, řádky
cli-help-compare = porovná dva slovníky nebo překlady, zpráva CSV, sloučení
cli-help-scan = analyzuje složku: co by zásobník přeložil z každého souboru
cli-help-convert = převody slovníků (EET, SST, XML, pivot, ximdb)
cli-help-package = zabalí výstupy složky pro správce modů (zip)
cli-help-batch = zřetězí příkazy dávkového souboru
cli-syntax-info = Použití: ximod-cli info <soubor>
cli-syntax-import = Použití: ximod-cli import <soubor> --format <id> [-o <ximdb|json>]
cli-syntax-apply = Použití: ximod-cli apply <soubor> [--dict <ximdb>…] [--base <složka>…] [--no-personal] [--mode strict|relax|textonly|normalized|formid|fuzzy] [--overwrite none|keep-validated|keep-pending|pending-only|all] [--write-dict]
cli-syntax-assist = Použití: ximod-cli assist <soubor> [--glossary] [--patterns] [--derive] [--overwrite …] [--write-dict]
cli-syntax-translate = Použití: ximod-cli translate <soubor> --service <id> [--scope untranslated|document] --max-chars <n> [--write-dict]
cli-syntax-check = Použití: ximod-cli check <soubor> [--fail-on error|warning] [--report <csv>]
cli-syntax-export = Použití: ximod-cli export <soubor> --output strings|hybrid|override|full|dsd [--statuses validated,pending,…] [--dict <ximdb>] [--strict] [--no-esl] -o <složka>
cli-syntax-manifest = Použití: ximod-cli manifest <složka> [--input <plugin>…] [-o <manifest.json>]
cli-syntax-compare = Použití: ximod-cli compare <A> <B> [--mode record|text] [--fold] [--report <csv>] [--merge <ximdb> --prefer a|b]
cli-syntax-scan = Použití: ximod-cli scan <složka> [--no-subdirs] [--scripts] [--report <csv>]
cli-syntax-convert = Použití: ximod-cli convert <vstup> -o <výstup>
cli-syntax-package = Použití: ximod-cli package <složka výstupů> [--name <mod>] [--version <verze>] [--author <autor>] [--website <adresa>] [--description <text>] [--plugin <esp>] [--no-info] [-o <zip>]
cli-syntax-batch = Použití: ximod-cli batch <dávka.json>
