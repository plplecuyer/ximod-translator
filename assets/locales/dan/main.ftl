# --- Kommandolinjen ximod-cli (D-06)
cli-usage = Brug: ximod-cli <kommando> [tilvalg]
cli-commands = Kommandoer:
cli-options-common = Fælles tilvalg: --game <id>, --from <iso3>, --to <iso3> (standard: filens header, derefter Config.ini), --json, --quiet, --verbose, --lang <iso3>, --no-color, --config <mappe>, --help
cli-help-hint = ximod-cli <kommando> --help: hjælp til en kommando. Returkoder: 0 udført, 1 udført med forbehold, 2 ikke udført.
cli-help-info = spil, registrerede sprog, linjer pr. type, mod-ordbog, brugerfladefiler
cli-help-import = åbner en tekst-, JSON- eller XML-fil med et format og skriver pivot eller ordbogen
cli-help-apply = åbner en fil, anvender ordbogsstakken, skriver mod-ordbogen (--write-dict)
cli-help-assist = anvender assistenterne (ordliste, mønstre, afledning) på hele dokumentet, linjer Afventer
cli-help-translate = oversætter dokumentets linjer online inden for --max-chars
cli-help-check = kvalitetskontrollerne, rapport pr. linje; kode 1 ved fejl
cli-help-export = skriver et output (strings, hybrid, override, full, dsd) fra mod-ordbogen
cli-help-manifest = beskriver outputtene i en mappe: størrelser, CRC-32, linjer
cli-help-compare = sammenligner to ordbøger eller oversættelser, CSV-rapport, fletning
cli-help-scan = analyserer en mappe: hvad stakken ville oversætte af hver fil
cli-help-convert = ordbogskonverteringer (EET, SST, XML, pivot, ximdb)
cli-help-package = pakker outputtene i en mappe til mod-managerne (zip)
cli-help-batch = kæder kommandoerne i en batchfil sammen
cli-syntax-info = Brug: ximod-cli info <fil>
cli-syntax-import = Brug: ximod-cli import <fil> --format <id> [-o <ximdb|json>]
cli-syntax-apply = Brug: ximod-cli apply <fil> [--dict <ximdb>…] [--base <mappe>…] [--no-personal] [--mode strict|relax|textonly|normalized|formid|fuzzy] [--overwrite none|keep-validated|keep-pending|pending-only|all] [--write-dict]
cli-syntax-assist = Brug: ximod-cli assist <fil> [--glossary] [--patterns] [--derive] [--overwrite …] [--write-dict]
cli-syntax-translate = Brug: ximod-cli translate <fil> --service <id> [--scope untranslated|document] --max-chars <n> [--write-dict]
cli-syntax-check = Brug: ximod-cli check <fil> [--fail-on error|warning] [--report <csv>]
cli-syntax-export = Brug: ximod-cli export <fil> --output strings|hybrid|override|full|dsd [--statuses validated,pending,…] [--dict <ximdb>] [--strict] [--no-esl] -o <mappe>
cli-syntax-manifest = Brug: ximod-cli manifest <mappe> [--input <plugin>…] [-o <manifest.json>]
cli-syntax-compare = Brug: ximod-cli compare <A> <B> [--mode record|text] [--fold] [--report <csv>] [--merge <ximdb> --prefer a|b]
cli-syntax-scan = Brug: ximod-cli scan <mappe> [--no-subdirs] [--scripts] [--report <csv>]
cli-syntax-convert = Brug: ximod-cli convert <inddata> -o <uddata>
cli-syntax-package = Brug: ximod-cli package <outputmappe> [--name <mod>] [--version <version>] [--author <forfatter>] [--website <adresse>] [--description <tekst>] [--plugin <esp>] [--no-info] [-o <zip>]
