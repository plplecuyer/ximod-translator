cli-syntax-check = Käyttö: ximod-cli check <tiedosto> [--fail-on error|warning] [--report <csv>]
cli-syntax-export = Käyttö: ximod-cli export <tiedosto> --output strings|hybrid|override|full|dsd [--statuses validated,pending,…] [--dict <ximdb>] [--strict] [--no-esl] -o <kansio>
cli-syntax-manifest = Käyttö: ximod-cli manifest <kansio> [--input <plugin>…] [-o <manifest.json>]
cli-syntax-compare = Käyttö: ximod-cli compare <A> <B> [--mode record|text] [--fold] [--report <csv>] [--merge <ximdb> --prefer a|b]
cli-syntax-scan = Käyttö: ximod-cli scan <kansio> [--no-subdirs] [--scripts] [--report <csv>]
cli-syntax-convert = Käyttö: ximod-cli convert <syöte> -o <tuloste>
cli-syntax-package = Käyttö: ximod-cli package <tulostekansio> [--name <mod>] [--version <versio>] [--author <tekijä>] [--website <osoite>] [--description <teksti>] [--plugin <esp>] [--no-info] [-o <zip>]
cli-syntax-batch = Käyttö: ximod-cli batch <erä.json>
cli-info-file = Tiedosto: { $path }
cli-info-kind = Tyyppi: { $kind }
cli-kind-plugin = liitännäinen
cli-kind-text = tekstitiedosto
cli-kind-dsd = DSD-käännös
cli-kind-script = kompiloitu skripti
cli-kind-dictionary = sanakirja
cli-info-game = Peli: { $game }
cli-info-langs = Tunnistetut kielet: { $langs }
cli-info-lines = Rivit: { $lines } ({ $detail })
cli-info-dict = Modisanakirja: { $state } — { $path }
cli-info-crc = Koko (tavua): { $size } · CRC-32: { $crc }
cli-info-interface = Käyttöliittymätiedostot: { $files }
cli-import-done = import — rivit: { $lines }, muoto { $format }: { $path }
cli-apply-done = apply — rivit: { $lines } · pino: { $stack } · käännettävänä: { $left } · lukitut: { $locked }
cli-apply-mode = apply --mode { $mode } — täytetyt rivit: { $n }, korvatut: { $over }
cli-dict-written = Modisanakirja kirjoitettu (rivit: { $lines }, muoto { $format }): { $path }
cli-assist-done = assist — täytetyt rivit: { $n } ({ $detail }), Odottava
cli-assist-detail = koostaminen: { $composed }, sanasto: { $glossary }, mallit: { $patterns }, johdannaiset: { $derived }
cli-translate-needs-max = translate: --max-chars on pakollinen (mitään ei lähetetä ilman rajaa).
cli-translate-over = translate — lähetettäviä merkkejä: { $chars }, yli --max-chars { $max }: mitään ei lähetetä.
cli-translate-done = translate — erillisiä tekstejä: { $items }, lähetettyjä merkkejä: { $chars }; vastaanotettuja rivejä: { $received }, hylättyjä: { $refused }, jäljellä: { $left } (Odottava)
cli-translate-no-key = translate: ei avainta palvelulle { $service } (avainnippu, secrets.json tai muuttuja { $var }).
cli-check-done = check — varoitukset: { $warnings }, virheet: { $errors }
cli-check-line = [{ $level }] rivi { $line } { $id }: { $text }
cli-level-error = virhe
cli-level-warning = varoitus
cli-export-done = export: { $path } (rivit: { $lines })
cli-export-left = export — viemättömät rivit (kääntämättömät tai poissuljetussa tilassa): { $n }
cli-export-same-file = export: tuloste korvaisi lähdetiedoston: { $path }
cli-manifest-done = manifest — tiedostot: { $files }, rivit: { $lines }, lähdeliitännäisen CRC-32: { $crc }
cli-scan-file = { $state } — { $file } — { $filled } / { $lines }
cli-convert-done = convert — rivit: { $lines }: { $path }
cli-package-done = package: { $path } (tiedostot: { $files })
cli-package-left = package: tiedosto jätetty pois (ei tunnettua paikkaa pelissä): { $file }
cli-batch-start = Erä — työt: { $jobs }, vaiheet: { $steps }
cli-batch-step = [{ $job }] { $step }: { $result }
cli-batch-end = Erä valmis — onnistuneet: { $ok }, varauksin: { $warn }, tekemättä: { $failed } — koodi { $code }
cli-err-usage = Tuntematon valitsin: { $arg } (ximod-cli --help)
cli-err-command = Tuntematon komento: { $arg } (ximod-cli --help)
cli-err-positional = { $command }: odotetaan tiedostoa tai kansiota (ximod-cli { $command } --help)
cli-err-missing = Pakollinen valitsin puuttuu: { $arg }
cli-err-value = Virheellinen arvo valitsimelle { $arg }: { $value }
cli-err-file = Tiedostoa ei löydy: { $path }
cli-err-kind = Tiedostoa ei tunnistettu (ei liitännäinen, tekstimuoto eikä käännös): { $path }
cli-err-format = Tuntematon muoto: { $id } (Työkalut › Data › Tekstimuodot…)
cli-err-batch = Virheellinen erätiedosto: { $reason }
cli-batch-json = Lukukelvoton JSON: { $error }
cli-batch-format = muoto { $format } (odotettu: 1)
cli-batch-no-jobs = ei töitä (jobs)
cli-batch-no-file = työ { $job }: ei tiedostoa (file tai files)
cli-batch-no-steps = työ { $job }: ei vaiheita (steps)
cli-batch-step-unknown = tuntematon vaihe: { $step }
cli-batch-option = vaiheen { $step } tuntematon valitsin: { $option }
err-manifest-format = Manifesti: muotoa { $format } ei tueta.
pack-note-manifest = Manifesti: fomod/manifest.json kuvaa käännöksen (lähdeliitännäinen ja sen CRC-32, tulosteet, viedyt tilat).
