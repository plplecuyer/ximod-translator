# --- Línea de comandos ximod-cli (D-06)
cli-usage = Uso: ximod-cli <comando> [opciones]
cli-commands = Comandos:
cli-options-common = Opciones comunes: --game <id>, --from <iso3>, --to <iso3> (por defecto: la cabecera del archivo, luego Config.ini), --json, --quiet, --verbose, --lang <iso3>, --no-color, --config <carpeta>, --help
cli-help-hint = ximod-cli <comando> --help: la ayuda de un comando. Códigos de retorno: 0 hecho, 1 hecho con reservas, 2 no hecho.
cli-help-info = juego, idiomas detectados, líneas por tipo, diccionario del mod, archivos de interfaz
cli-help-import = abre un archivo de texto, JSON o XML con un formato y escribe el pivot o el diccionario
cli-help-apply = abre un archivo, aplica la pila de diccionarios, escribe el diccionario del mod (--write-dict)
cli-help-assist = aplica los asistentes (glosario, patrones, derivación) a todo el documento, líneas Pendiente
cli-help-translate = traduce en línea las líneas del documento, dentro del límite de --max-chars
cli-help-check = los controles de calidad, informe por línea; código 1 si hay errores
cli-help-export = escribe una salida (strings, hybrid, override, full, dsd) desde el diccionario del mod
cli-help-manifest = describe las salidas de una carpeta: tamaños, CRC-32, líneas
cli-help-compare = compara dos diccionarios o traducciones, informe CSV, fusión
cli-help-scan = analiza una carpeta: lo que la pila traduciría de cada archivo
cli-help-convert = conversiones de diccionarios (EET, SST, XML, pivot, ximdb)
cli-help-package = empaqueta las salidas de una carpeta para los gestores de mods (zip)
cli-help-batch = encadena los comandos de un archivo de lote
cli-syntax-info = Uso: ximod-cli info <archivo>
cli-syntax-import = Uso: ximod-cli import <archivo> --format <id> [-o <ximdb|json>]
cli-syntax-apply = Uso: ximod-cli apply <archivo> [--dict <ximdb>…] [--base <carpeta>…] [--no-personal] [--mode strict|relax|textonly|normalized|formid|fuzzy] [--overwrite none|keep-validated|keep-pending|pending-only|all] [--write-dict]
cli-syntax-assist = Uso: ximod-cli assist <archivo> [--glossary] [--patterns] [--derive] [--overwrite …] [--write-dict]
cli-syntax-translate = Uso: ximod-cli translate <archivo> --service <id> [--scope untranslated|document] --max-chars <n> [--write-dict]
cli-syntax-check = Uso: ximod-cli check <archivo> [--fail-on error|warning] [--report <csv>]
cli-syntax-export = Uso: ximod-cli export <archivo> --output strings|hybrid|override|full|dsd [--statuses validated,pending,…] [--dict <ximdb>] [--strict] [--no-esl] -o <carpeta>
cli-syntax-manifest = Uso: ximod-cli manifest <carpeta> [--input <plugin>…] [-o <manifest.json>]
cli-syntax-compare = Uso: ximod-cli compare <A> <B> [--mode record|text] [--fold] [--report <csv>] [--merge <ximdb> --prefer a|b]
cli-syntax-scan = Uso: ximod-cli scan <carpeta> [--no-subdirs] [--scripts] [--report <csv>]
cli-syntax-convert = Uso: ximod-cli convert <entrada> -o <salida>
cli-syntax-package = Uso: ximod-cli package <carpeta de salidas> [--name <mod>] [--version <versión>] [--author <autor>] [--website <dirección>] [--description <texto>] [--plugin <esp>] [--no-info] [-o <zip>]
cli-syntax-batch = Uso: ximod-cli batch <lote.json>
