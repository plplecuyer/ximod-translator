cli-help-hint = ximod-cli <príkaz> --help: pomocník k príkazu. Návratové kódy: 0 hotovo, 1 hotovo s výhradami, 2 nehotovo.
cli-help-info = hra, zistené jazyky, riadky podľa typu, slovník modu, súbory rozhrania
cli-help-import = otvorí textový súbor, JSON alebo XML s formátom a zapíše pivot alebo slovník
cli-help-apply = otvorí súbor, použije zásobník slovníkov, zapíše slovník modu (--write-dict)
cli-help-assist = použije asistentov (glosár, vzory, odvodeniny) na celý dokument, riadky Čakajúce
cli-help-translate = preloží riadky dokumentu online, v rámci --max-chars
cli-help-check = kontroly kvality, správa po riadkoch; kód 1 pri chybách
cli-help-export = zapíše výstup (strings, hybrid, override, full, dsd) zo slovníka modu
cli-help-manifest = opíše výstupy priečinka: veľkosti, CRC-32, riadky
cli-help-compare = porovná dva slovníky alebo preklady, správa CSV, zlúčenie
cli-help-scan = analyzuje priečinok: čo by zásobník preložil z každého súboru
cli-help-convert = prevody slovníkov (EET, SST, XML, pivot, ximdb)
cli-help-package = zabalí výstupy priečinka pre správcov modov (zip)
cli-help-batch = zreťazí príkazy dávkového súboru
cli-syntax-info = Použitie: ximod-cli info <súbor>
cli-syntax-import = Použitie: ximod-cli import <súbor> --format <id> [-o <ximdb|json>]
cli-syntax-apply = Použitie: ximod-cli apply <súbor> [--dict <ximdb>…] [--base <priečinok>…] [--no-personal] [--mode strict|relax|textonly|normalized|formid|fuzzy] [--overwrite none|keep-validated|keep-pending|pending-only|all] [--write-dict]
cli-syntax-assist = Použitie: ximod-cli assist <súbor> [--glossary] [--patterns] [--derive] [--overwrite …] [--write-dict]
cli-syntax-translate = Použitie: ximod-cli translate <súbor> --service <id> [--scope untranslated|document] --max-chars <n> [--write-dict]
cli-syntax-check = Použitie: ximod-cli check <súbor> [--fail-on error|warning] [--report <csv>]
cli-syntax-export = Použitie: ximod-cli export <súbor> --output strings|hybrid|override|full|dsd [--statuses validated,pending,…] [--dict <ximdb>] [--strict] [--no-esl] -o <priečinok>
cli-syntax-manifest = Použitie: ximod-cli manifest <priečinok> [--input <plugin>…] [-o <manifest.json>]
cli-syntax-compare = Použitie: ximod-cli compare <A> <B> [--mode record|text] [--fold] [--report <csv>] [--merge <ximdb> --prefer a|b]
cli-syntax-scan = Použitie: ximod-cli scan <priečinok> [--no-subdirs] [--scripts] [--report <csv>]
cli-syntax-convert = Použitie: ximod-cli convert <vstup> -o <výstup>
cli-syntax-package = Použitie: ximod-cli package <priečinok výstupov> [--name <mod>] [--version <verzia>] [--author <autor>] [--website <adresa>] [--description <text>] [--plugin <esp>] [--no-info] [-o <zip>]
cli-syntax-batch = Použitie: ximod-cli batch <dávka.json>
