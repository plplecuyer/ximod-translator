# --- ximod-cli komandrinda (D-06)
cli-usage = Lietojums: ximod-cli <komanda> [opcijas]
cli-commands = Komandas:
cli-options-common = Kopīgās opcijas: --game <id>, --from <iso3>, --to <iso3> (noklusējums: faila galvene, tad Config.ini), --json, --quiet, --verbose, --log <fails>, --lang <iso3>, --no-color, --config <mape>, --help
cli-help-hint = ximod-cli <komanda> --help: komandas palīdzība. Atgriešanas kodi: 0 izdarīts, 1 izdarīts ar iebildēm, 2 nav izdarīts.
cli-help-info = spēle, noteiktās valodas, rindas pēc veida, moda vārdnīca, saskarnes faili
cli-help-import = atver teksta, JSON vai XML failu ar formātu un raksta pivot vai vārdnīcu
cli-help-apply = atver failu, lieto vārdnīcu steku, raksta moda vārdnīcu (--write-dict)
cli-help-assist = lieto palīgus (glosārijs, šabloni, atvasinājumi) visam dokumentam, rindas Gaida
cli-help-translate = tulko dokumenta rindas tiešsaistē, --max-chars robežās
cli-help-check = kvalitātes pārbaudes, atskaite pa rindām; kods 1 kļūdu gadījumā
cli-help-export = raksta izvadi (strings, hybrid, override, full, dsd) no moda vārdnīcas
cli-help-manifest = apraksta mapes izvades: izmēri, CRC-32, rindas
cli-help-compare = salīdzina divas vārdnīcas vai tulkojumus, CSV atskaite, apvienošana
cli-help-scan = analizē mapi: ko steks iztulkotu no katra faila
cli-help-convert = vārdnīcu pārveidošana (EET, SST, XML, pivot, ximdb)
cli-help-package = sapako mapes izvades modu pārvaldniekiem (zip)
cli-help-batch = virknē paketes faila komandas
cli-syntax-info = Lietojums: ximod-cli info <fails>
cli-syntax-import = Lietojums: ximod-cli import <fails> --format <id> [-o <ximdb|json>]
cli-syntax-apply = Lietojums: ximod-cli apply <fails> [--dict <ximdb>…] [--base <mape>…] [--no-personal] [--mode strict|relax|textonly|normalized|formid|fuzzy] [--overwrite none|keep-validated|keep-pending|pending-only|all] [--write-dict]
cli-syntax-assist = Lietojums: ximod-cli assist <fails> [--glossary] [--patterns] [--derive] [--overwrite …] [--write-dict]
cli-syntax-translate = Lietojums: ximod-cli translate <fails> --service <id> [--scope untranslated|document] --max-chars <n> [--write-dict]
cli-syntax-check = Lietojums: ximod-cli check <fails> [--fail-on error|warning] [--report <csv>]
cli-syntax-export = Lietojums: ximod-cli export <fails> --output strings|hybrid|override|full|dsd [--statuses validated,pending,…] [--dict <ximdb>] [--strict] [--no-esl] -o <mape>
cli-syntax-manifest = Lietojums: ximod-cli manifest <mape> [--input <plugin>…] [-o <manifest.json>]
cli-syntax-compare = Lietojums: ximod-cli compare <A> <B> [--mode record|text] [--fold] [--report <csv>] [--merge <ximdb> --prefer a|b]
cli-syntax-scan = Lietojums: ximod-cli scan <mape> [--no-subdirs] [--scripts] [--report <csv>]
cli-syntax-convert = Lietojums: ximod-cli convert <ievade> -o <izvade>
cli-syntax-package = Lietojums: ximod-cli package <izvadu mape> [--name <mod>] [--version <versija>] [--author <autors>] [--website <adrese>] [--description <teksts>] [--plugin <esp>] [--no-info] [-o <zip>]
