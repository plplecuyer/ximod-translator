cli-syntax-check = الاستخدام: ximod-cli check <ملف> [--fail-on error|warning] [--report <csv>]
cli-syntax-export = الاستخدام: ximod-cli export <ملف> --output strings|hybrid|override|full|dsd [--statuses validated,pending,…] [--dict <ximdb>] [--strict] [--no-esl] -o <مجلد>
cli-syntax-manifest = الاستخدام: ximod-cli manifest <مجلد> [--input <plugin>…] [-o <manifest.json>]
cli-syntax-compare = الاستخدام: ximod-cli compare <A> <B> [--mode record|text] [--fold] [--report <csv>] [--merge <ximdb> --prefer a|b]
cli-syntax-scan = الاستخدام: ximod-cli scan <مجلد> [--no-subdirs] [--scripts] [--report <csv>]
cli-syntax-convert = الاستخدام: ximod-cli convert <إدخال> -o <إخراج>
cli-syntax-package = الاستخدام: ximod-cli package <مجلد المخرجات> [--name <mod>] [--version <إصدار>] [--author <مؤلف>] [--website <عنوان>] [--description <نص>] [--plugin <esp>] [--no-info] [-o <zip>]
