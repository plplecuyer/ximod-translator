# --- ximod-cli command line (D-06)
cli-usage = Usage: ximod-cli <command> [options]
cli-commands = Commands:
cli-options-common = Common options: --game <id>, --from <iso3>, --to <iso3> (defaults: the file header, then Config.ini), --json, --quiet, --verbose, --lang <iso3>, --no-color, --config <folder>, --help
cli-help-hint = ximod-cli <command> --help: the help of a command. Return codes: 0 done, 1 done with reservations, 2 not done.
cli-help-info = game, detected languages, lines per type, mod dictionary, interface files
cli-help-import = opens a text, JSON or XML file with a format and writes the pivot or the dictionary
cli-help-apply = opens a file, applies the dictionary stack, writes the mod dictionary (--write-dict)
cli-help-assist = applies the assistants (glossary, patterns, derivation) to the whole document, lines Pending
cli-help-translate = translates the lines of the document online, within --max-chars
cli-help-check = the quality checks, report per line; code 1 on errors
cli-help-export = writes an output (strings, hybrid, override, full, dsd) from the mod dictionary
cli-help-manifest = describes the outputs of a folder: sizes, CRC-32, lines
cli-help-compare = compares two dictionaries or translations, CSV report, merge
cli-help-scan = analyses a folder: what the stack would translate of each file
cli-help-convert = dictionary conversions (EET, SST, XML, pivot, ximdb)
cli-help-package = packages the outputs of a folder for the mod managers (zip)
cli-help-batch = chains the commands of a batch file
cli-syntax-info = Usage: ximod-cli info <file>
cli-syntax-import = Usage: ximod-cli import <file> --format <id> [-o <ximdb|json>]
cli-syntax-apply = Usage: ximod-cli apply <file> [--dict <ximdb>…] [--base <folder>…] [--no-personal] [--mode strict|relax|textonly|normalized|formid|fuzzy] [--overwrite none|keep-validated|keep-pending|pending-only|all] [--write-dict]
cli-syntax-assist = Usage: ximod-cli assist <file> [--glossary] [--patterns] [--derive] [--overwrite …] [--write-dict]
cli-syntax-translate = Usage: ximod-cli translate <file> --service <id> [--scope untranslated|document] --max-chars <n> [--write-dict]
cli-syntax-check = Usage: ximod-cli check <file> [--fail-on error|warning] [--report <csv>]
cli-syntax-export = Usage: ximod-cli export <file> --output strings|hybrid|override|full|dsd [--statuses validated,pending,…] [--dict <ximdb>] [--strict] [--no-esl] -o <folder>
cli-syntax-manifest = Usage: ximod-cli manifest <folder> [--input <plugin>…] [-o <manifest.json>]
cli-syntax-compare = Usage: ximod-cli compare <A> <B> [--mode record|text] [--fold] [--report <csv>] [--merge <ximdb> --prefer a|b]
cli-syntax-scan = Usage: ximod-cli scan <folder> [--no-subdirs] [--scripts] [--report <csv>]
cli-syntax-convert = Usage: ximod-cli convert <input> -o <output>
cli-syntax-package = Usage: ximod-cli package <outputs folder> [--name <mod>] [--version <version>] [--author <author>] [--website <address>] [--description <text>] [--plugin <esp>] [--no-info] [-o <zip>]
cli-syntax-batch = Usage: ximod-cli batch <batch.json>
