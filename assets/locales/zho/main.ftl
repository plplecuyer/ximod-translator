cli-err-value = { $arg } 的值无效：{ $value }
cli-err-file = 找不到文件：{ $path }
cli-err-kind = 无法识别的文件（既不是插件，也不是文本格式或译文）：{ $path }
cli-err-format = 未知格式：{ $id }（工具 › 数据 › 文本格式…）
cli-err-batch = 无效的批处理文件：{ $reason }
cli-batch-json = 无法读取的 JSON：{ $error }
cli-batch-format = 格式 { $format }（应为：1）
