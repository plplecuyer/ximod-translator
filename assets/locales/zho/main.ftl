cli-help-translate = 在 --max-chars 限额内在线翻译文档的行
cli-help-check = 质量检查，逐行报告；有错误时返回码 1
cli-help-export = 从模组词典写入输出 (strings, hybrid, override, full, dsd)
cli-help-manifest = 描述文件夹的输出：大小、CRC-32、行
cli-help-compare = 比较两个词典或译文，CSV 报告，合并
cli-help-scan = 分析文件夹：词典栈能翻译每个文件中的哪些内容
cli-help-convert = 词典转换 (EET, SST, XML, pivot, ximdb)
cli-help-package = 为模组管理器打包文件夹的输出 (zip)
cli-help-batch = 依次执行批处理文件中的命令
cli-syntax-info = 用法：ximod-cli info <文件>
cli-syntax-import = 用法：ximod-cli import <文件> --format <id> [-o <ximdb|json>]
cli-syntax-apply = 用法：ximod-cli apply <文件> [--dict <ximdb>…] [--base <文件夹>…] [--no-personal] [--mode strict|relax|textonly|normalized|formid|fuzzy] [--overwrite none|keep-validated|keep-pending|pending-only|all] [--write-dict]
cli-syntax-assist = 用法：ximod-cli assist <文件> [--glossary] [--patterns] [--derive] [--overwrite …] [--write-dict]
cli-syntax-translate = 用法：ximod-cli translate <文件> --service <id> [--scope untranslated|document] --max-chars <n> [--write-dict]
cli-syntax-check = 用法：ximod-cli check <文件> [--fail-on error|warning] [--report <csv>]
cli-syntax-export = 用法：ximod-cli export <文件> --output strings|hybrid|override|full|dsd [--statuses validated,pending,…] [--dict <ximdb>] [--strict] [--no-esl] -o <文件夹>
cli-syntax-manifest = 用法：ximod-cli manifest <文件夹> [--input <plugin>…] [-o <manifest.json>]
cli-syntax-compare = 用法：ximod-cli compare <A> <B> [--mode record|text] [--fold] [--report <csv>] [--merge <ximdb> --prefer a|b]
cli-syntax-scan = 用法：ximod-cli scan <文件夹> [--no-subdirs] [--scripts] [--report <csv>]
cli-syntax-convert = 用法：ximod-cli convert <输入> -o <输出>
cli-syntax-package = 用法：ximod-cli package <输出文件夹> [--name <mod>] [--version <版本>] [--author <作者>] [--website <地址>] [--description <文本>] [--plugin <esp>] [--no-info] [-o <zip>]
cli-syntax-batch = 用法：ximod-cli batch <批处理.json>
cli-info-file = 文件：{ $path }
cli-info-kind = 类型：{ $kind }
cli-kind-plugin = 插件
cli-kind-text = 文本文件
cli-kind-dsd = DSD 译文
cli-kind-script = 已编译脚本
cli-kind-dictionary = 词典
