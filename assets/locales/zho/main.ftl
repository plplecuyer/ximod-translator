cli-info-langs = 检测到的语言：{ $langs }
cli-info-lines = 行：{ $lines }（{ $detail }）
cli-info-dict = 模组词典：{ $state } — { $path }
cli-info-crc = 大小（字节）：{ $size } · CRC-32：{ $crc }
cli-info-interface = 界面文件：{ $files }
cli-import-done = import — 行：{ $lines }，格式 { $format }：{ $path }
cli-apply-done = apply — 行：{ $lines } · 词典栈：{ $stack } · 待翻译：{ $left } · 已锁定：{ $locked }
cli-apply-mode = apply --mode { $mode } — 已填充行：{ $n }，已替换：{ $over }
cli-dict-written = 模组词典已写入（行：{ $lines }，格式 { $format }）：{ $path }
cli-assist-done = assist — 已填充行：{ $n }（{ $detail }），待定
cli-assist-detail = 组合：{ $composed }，术语表：{ $glossary }，模式：{ $patterns }，派生：{ $derived }
cli-translate-needs-max = translate：--max-chars 为必填项（没有限额时不发送任何内容）。
cli-translate-over = translate — 待发送字符：{ $chars }，超出 --max-chars { $max }：不发送任何内容。
cli-translate-done = translate — 不同文本：{ $items }，已发送字符：{ $chars }；已接收行：{ $received }，被拒绝：{ $refused }，剩余：{ $left }（待定）
cli-translate-no-key = translate：没有 { $service } 的密钥（密钥环、secrets.json 或变量 { $var }）。
cli-check-done = check — 警告：{ $warnings }，错误：{ $errors }
cli-check-line = [{ $level }] 第 { $line } 行 { $id }：{ $text }
cli-level-error = 错误
cli-level-warning = 警告
cli-export-done = export：{ $path }（行：{ $lines }）
cli-export-left = export — 未导出的行（未翻译或属于被排除的状态）：{ $n }
cli-export-same-file = export：输出将覆盖源文件：{ $path }
cli-manifest-done = manifest — 文件：{ $files }，行：{ $lines }，源插件的 CRC-32：{ $crc }
cli-scan-file = { $state } — { $file } — { $filled } / { $lines }
cli-convert-done = convert — 行：{ $lines }：{ $path }
cli-package-done = package：{ $path }（文件：{ $files }）
cli-package-left = package：已排除文件（此游戏中没有已知位置）：{ $file }
cli-batch-start = 批处理 — 作业：{ $jobs }，步骤：{ $steps }
cli-batch-step = [{ $job }] { $step }：{ $result }
cli-batch-end = 批处理已结束 — 成功：{ $ok }，有保留：{ $warn }，未完成：{ $failed } — 返回码 { $code }
