# --- Kommandolinjen ximod-cli (D-06)
cli-usage = Bruk: ximod-cli <kommando> [valg]
cli-commands = Kommandoer:
cli-options-common = Felles valg: --game <id>, --from <iso3>, --to <iso3> (standard: filhodet, deretter Config.ini), --json, --quiet, --verbose, --lang <iso3>, --no-color, --config <mappe>, --help
cli-help-hint = ximod-cli <kommando> --help: hjelp for en kommando. Returkoder: 0 fullført, 1 fullført med forbehold, 2 ikke utført.
cli-help-info = spill, oppdagede språk, linjer per type, mod-ordbok, grensesnittfiler
cli-help-import = åpner en tekst-, JSON- eller XML-fil med et format og skriver pivot eller ordboken
cli-help-apply = åpner en fil, bruker ordbokstakken, skriver mod-ordboken (--write-dict)
cli-help-assist = bruker assistentene (ordliste, mønstre, avledning) på hele dokumentet, linjer Venter
cli-help-translate = oversetter dokumentets linjer på nett, innenfor --max-chars
cli-help-check = kvalitetskontrollene, rapport per linje; kode 1 ved feil
cli-help-export = skriver utdata (strings, hybrid, override, full, dsd) fra mod-ordboken
cli-help-manifest = beskriver utdataene i en mappe: størrelser, CRC-32, linjer
cli-help-compare = sammenligner to ordbøker eller oversettelser, CSV-rapport, fletting
cli-help-scan = analyserer en mappe: hva stakken ville oversatt av hver fil
cli-help-convert = ordbokkonverteringer (EET, SST, XML, pivot, ximdb)
cli-help-package = pakker utdataene i en mappe for modbehandlerne (zip)
cli-help-batch = kjeder sammen kommandoene i en satsfil
cli-syntax-info = Bruk: ximod-cli info <fil>
cli-syntax-import = Bruk: ximod-cli import <fil> --format <id> [-o <ximdb|json>]
cli-syntax-apply = Bruk: ximod-cli apply <fil> [--dict <ximdb>…] [--base <mappe>…] [--no-personal] [--mode strict|relax|textonly|normalized|formid|fuzzy] [--overwrite none|keep-validated|keep-pending|pending-only|all] [--write-dict]
cli-syntax-assist = Bruk: ximod-cli assist <fil> [--glossary] [--patterns] [--derive] [--overwrite …] [--write-dict]
cli-syntax-translate = Bruk: ximod-cli translate <fil> --service <id> [--scope untranslated|document] --max-chars <n> [--write-dict]
cli-syntax-check = Bruk: ximod-cli check <fil> [--fail-on error|warning] [--report <csv>]
cli-syntax-export = Bruk: ximod-cli export <fil> --output strings|hybrid|override|full|dsd [--statuses validated,pending,…] [--dict <ximdb>] [--strict] [--no-esl] -o <mappe>
cli-syntax-manifest = Bruk: ximod-cli manifest <mappe> [--input <plugin>…] [-o <manifest.json>]
cli-syntax-compare = Bruk: ximod-cli compare <A> <B> [--mode record|text] [--fold] [--report <csv>] [--merge <ximdb> --prefer a|b]
cli-syntax-scan = Bruk: ximod-cli scan <mappe> [--no-subdirs] [--scripts] [--report <csv>]
cli-syntax-convert = Bruk: ximod-cli convert <inndata> -o <utdata>
cli-syntax-package = Bruk: ximod-cli package <utdatamappe> [--name <mod>] [--version <versjon>] [--author <forfatter>] [--website <adresse>] [--description <tekst>] [--plugin <esp>] [--no-info] [-o <zip>]
