# --- Opdrachtregel ximod-cli (D-06)
cli-usage = Gebruik: ximod-cli <opdracht> [opties]
cli-commands = Opdrachten:
cli-options-common = Gemeenschappelijke opties: --game <id>, --from <iso3>, --to <iso3> (standaard: de bestandskop, daarna Config.ini), --json, --quiet, --verbose, --lang <iso3>, --no-color, --config <map>, --help
cli-help-hint = ximod-cli <opdracht> --help: de hulp bij een opdracht. Retourcodes: 0 klaar, 1 klaar met voorbehoud, 2 niet gedaan.
cli-help-info = spel, gedetecteerde talen, regels per type, modwoordenboek, interfacebestanden
cli-help-import = opent een tekst-, JSON- of XML-bestand met een indeling en schrijft de pivot of het woordenboek
cli-help-apply = opent een bestand, past de woordenboekstapel toe, schrijft het modwoordenboek (--write-dict)
cli-help-assist = past de assistenten (woordenlijst, patronen, afleiding) toe op het hele document, regels In afwachting
cli-help-translate = vertaalt de regels van het document online, binnen --max-chars
cli-help-check = de kwaliteitscontroles, rapport per regel; code 1 bij fouten
cli-help-export = schrijft een uitvoer (strings, hybrid, override, full, dsd) vanuit het modwoordenboek
cli-help-manifest = beschrijft de uitvoer van een map: groottes, CRC-32, regels
cli-help-compare = vergelijkt twee woordenboeken of vertalingen, CSV-rapport, samenvoegen
cli-help-scan = analyseert een map: wat de stapel van elk bestand zou vertalen
cli-help-convert = woordenboekconversies (EET, SST, XML, pivot, ximdb)
cli-help-package = verpakt de uitvoer van een map voor de modmanagers (zip)
cli-help-batch = voert de opdrachten van een batchbestand na elkaar uit
cli-syntax-info = Gebruik: ximod-cli info <bestand>
cli-syntax-import = Gebruik: ximod-cli import <bestand> --format <id> [-o <ximdb|json>]
cli-syntax-apply = Gebruik: ximod-cli apply <bestand> [--dict <ximdb>…] [--base <map>…] [--no-personal] [--mode strict|relax|textonly|normalized|formid|fuzzy] [--overwrite none|keep-validated|keep-pending|pending-only|all] [--write-dict]
cli-syntax-assist = Gebruik: ximod-cli assist <bestand> [--glossary] [--patterns] [--derive] [--overwrite …] [--write-dict]
cli-syntax-translate = Gebruik: ximod-cli translate <bestand> --service <id> [--scope untranslated|document] --max-chars <n> [--write-dict]
cli-syntax-check = Gebruik: ximod-cli check <bestand> [--fail-on error|warning] [--report <csv>]
cli-syntax-export = Gebruik: ximod-cli export <bestand> --output strings|hybrid|override|full|dsd [--statuses validated,pending,…] [--dict <ximdb>] [--strict] [--no-esl] -o <map>
cli-syntax-manifest = Gebruik: ximod-cli manifest <map> [--input <plugin>…] [-o <manifest.json>]
cli-syntax-compare = Gebruik: ximod-cli compare <A> <B> [--mode record|text] [--fold] [--report <csv>] [--merge <ximdb> --prefer a|b]
cli-syntax-scan = Gebruik: ximod-cli scan <map> [--no-subdirs] [--scripts] [--report <csv>]
cli-syntax-convert = Gebruik: ximod-cli convert <invoer> -o <uitvoer>
cli-syntax-package = Gebruik: ximod-cli package <uitvoermap> [--name <mod>] [--version <versie>] [--author <auteur>] [--website <adres>] [--description <tekst>] [--plugin <esp>] [--no-info] [-o <zip>]
