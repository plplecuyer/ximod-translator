# --- ximod-cli komut satırı (D-06)
cli-usage = Kullanım: ximod-cli <komut> [seçenekler]
cli-commands = Komutlar:
cli-options-common = Ortak seçenekler: --game <id>, --from <iso3>, --to <iso3> (varsayılanlar: dosya başlığı, sonra Config.ini), --json, --quiet, --verbose, --log <dosya>, --lang <iso3>, --no-color, --config <klasör>, --help
cli-help-hint = ximod-cli <komut> --help: bir komutun yardımı. Dönüş kodları: 0 tamamlandı, 1 çekincelerle tamamlandı, 2 tamamlanmadı.
cli-help-info = oyun, algılanan diller, türe göre satırlar, mod sözlüğü, arayüz dosyaları
cli-help-import = bir metin, JSON veya XML dosyasını bir biçimle açar ve pivotu ya da sözlüğü yazar
cli-help-apply = bir dosya açar, sözlük yığınını uygular, mod sözlüğünü yazar (--write-dict)
cli-help-assist = yardımcıları (sözlükçe, kalıplar, türetme) tüm belgeye uygular, satırlar Beklemede
cli-help-translate = belgenin satırlarını --max-chars sınırı içinde çevrimiçi çevirir
cli-help-check = kalite denetimleri, satır başına rapor; hata varsa kod 1
cli-help-export = mod sözlüğünden bir çıktı (strings, hybrid, override, full, dsd) yazar
cli-help-manifest = bir klasörün çıktılarını açıklar: boyutlar, CRC-32, satırlar
cli-help-compare = iki sözlüğü veya çeviriyi karşılaştırır, CSV raporu, birleştirme
cli-help-scan = bir klasörü analiz eder: yığın her dosyadan neyi çevirirdi
cli-help-convert = sözlük dönüştürmeleri (EET, SST, XML, pivot, ximdb)
cli-help-package = bir klasörün çıktılarını mod yöneticileri için paketler (zip)
cli-help-batch = bir toplu iş dosyasının komutlarını sırayla çalıştırır
cli-syntax-info = Kullanım: ximod-cli info <dosya>
cli-syntax-import = Kullanım: ximod-cli import <dosya> --format <id> [-o <ximdb|json>]
