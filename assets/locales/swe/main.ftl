# --- Kommandoraden ximod-cli (D-06)
cli-usage = Användning: ximod-cli <kommando> [flaggor]
cli-commands = Kommandon:
cli-options-common = Gemensamma flaggor: --game <id>, --from <iso3>, --to <iso3> (standard: filens huvud, sedan Config.ini), --json, --quiet, --verbose, --lang <iso3>, --no-color, --config <mapp>, --help
cli-help-hint = ximod-cli <kommando> --help: hjälp för ett kommando. Returkoder: 0 klart, 1 klart med reservationer, 2 inte gjort.
cli-help-info = spel, identifierade språk, rader per typ, moddordbok, gränssnittsfiler
cli-help-import = öppnar en text-, JSON- eller XML-fil med ett format och skriver pivot eller ordboken
cli-help-apply = öppnar en fil, tillämpar ordboksstacken, skriver moddordboken (--write-dict)
cli-help-assist = tillämpar assistenterna (ordlista, mönster, avledning) på hela dokumentet, rader Väntande
cli-help-translate = översätter dokumentets rader online, inom --max-chars
cli-help-check = kvalitetskontrollerna, rapport per rad; kod 1 vid fel
cli-help-export = skriver utdata (strings, hybrid, override, full, dsd) från moddordboken
cli-help-manifest = beskriver utdata i en mapp: storlekar, CRC-32, rader
cli-help-compare = jämför två ordböcker eller översättningar, CSV-rapport, sammanfogning
cli-help-scan = analyserar en mapp: vad stacken skulle översätta av varje fil
cli-help-convert = ordbokskonverteringar (EET, SST, XML, pivot, ximdb)
cli-help-package = paketerar utdata i en mapp för modhanterarna (zip)
cli-help-batch = kedjar kommandona i en satsfil
cli-syntax-info = Användning: ximod-cli info <fil>
cli-syntax-import = Användning: ximod-cli import <fil> --format <id> [-o <ximdb|json>]
cli-syntax-apply = Användning: ximod-cli apply <fil> [--dict <ximdb>…] [--base <mapp>…] [--no-personal] [--mode strict|relax|textonly|normalized|formid|fuzzy] [--overwrite none|keep-validated|keep-pending|pending-only|all] [--write-dict]
cli-syntax-assist = Användning: ximod-cli assist <fil> [--glossary] [--patterns] [--derive] [--overwrite …] [--write-dict]
cli-syntax-translate = Användning: ximod-cli translate <fil> --service <id> [--scope untranslated|document] --max-chars <n> [--write-dict]
cli-syntax-check = Användning: ximod-cli check <fil> [--fail-on error|warning] [--report <csv>]
cli-syntax-export = Användning: ximod-cli export <fil> --output strings|hybrid|override|full|dsd [--statuses validated,pending,…] [--dict <ximdb>] [--strict] [--no-esl] -o <mapp>
cli-syntax-manifest = Användning: ximod-cli manifest <mapp> [--input <plugin>…] [-o <manifest.json>]
cli-syntax-compare = Användning: ximod-cli compare <A> <B> [--mode record|text] [--fold] [--report <csv>] [--merge <ximdb> --prefer a|b]
cli-syntax-scan = Användning: ximod-cli scan <mapp> [--no-subdirs] [--scripts] [--report <csv>]
cli-syntax-convert = Användning: ximod-cli convert <indata> -o <utdata>
cli-syntax-package = Användning: ximod-cli package <utdatamapp> [--name <mod>] [--version <version>] [--author <författare>] [--website <adress>] [--description <text>] [--plugin <esp>] [--no-info] [-o <zip>]
cli-syntax-batch = Användning: ximod-cli batch <sats.json>
